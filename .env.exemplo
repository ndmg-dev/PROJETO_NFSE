# Copie para .env e preencha. O .env está no .gitignore — nunca versione.

POSTGRES_PASSWORD=troque-me

# Senha do papel sem privilégio que a aplicação usa (ver §8)
APP_DB_PASSWORD=troque-me-tambem

# Chave mestra do cofre de certificados (32 bytes em base64):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# ATENÇÃO: chave em .env está ABAIXO do exigido pela spec §8, que pede KMS.
# Aceitável só em desenvolvimento. Ver app/core/cofre.py.
COFRE_MASTER_KEY=

# Assinatura dos JWT (32 bytes em base64, gerada como acima)
JWT_SECRET=

AMBIENTE_ADN=restrita
