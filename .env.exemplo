# Você não precisa criar este arquivo à mão: iniciar.sh e Iniciar.bat geram o .env com
# senhas aleatórias na primeira execução. Este exemplo é só para quem desenvolve.

# Copie para .env e preencha. O .env está no .gitignore — nunca versione.

POSTGRES_PASSWORD=troque-me

# Senha do papel sem privilégio que a aplicação usa (ver §8)
APP_DB_PASSWORD=troque-me-tambem

# Assinatura dos JWT (32 bytes em base64):
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
JWT_SECRET=

AMBIENTE_ADN=restrita

# Não há mais COFRE_MASTER_KEY (spec §3.3-A, 22/09/2026): o certificado nunca
# sobe para o servidor, então não existe mais cofre central para cifrar.
